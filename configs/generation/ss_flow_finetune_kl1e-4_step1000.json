{
    "models": {
        "denoiser": {
            "name": "SparseStructureFlowModel",
            "args": {
                "resolution": 16,
                "in_channels": 8,
                "out_channels": 8,
                "model_channels": 1024,
                "cond_channels": 1024,
                "num_blocks": 24,
                "num_heads": 16,
                "mlp_ratio": 4,
                "patch_size": 1,
                "pe_mode": "ape",
                "qk_rms_norm": true,
                "use_fp16": true
            }
        }
    },
    "dataset": {
        "name": "ImageConditionedSparseStructureLatent",
        "args": {
            "latent_model": "ss_enc_dec_fine_tune_kl1e-4_step0001000",
            "min_aesthetic_score": 4.5,
            "image_size": 518,
            "ss_dec_path": "outputs/train/ss_enc_dec_fine_tune_kl1e-4",
            "ss_dec_ckpt": "step0001000"
        }
    },
    "trainer": {
        "name": "ImageConditionedFlowMatchingCFGTrainer",
        "args": {
            "max_steps": 1000,
            "batch_size_per_gpu": 16,
            "batch_split": 8,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 0.00001,
                    "weight_decay": 0.0
                }
            },
            "resume_optimizer_lr": "config",
            "ema_rate": [
                0.9999
            ],
            "fp16_mode": "inflat_all",
            "fp16_scale_growth": 0.001,
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "i_print": 10,
            "i_log": 10,
            "i_sample": 2000,
            "i_save": 500,
            "p_uncond": 0.1,
            "t_schedule": {
                "name": "logitNormal",
                "args": {
                    "mean": 1.0,
                    "std": 1.0
                }
            },
            "sigma_min": 1e-5,
            "image_cond_model": "dinov2_vitl14_reg",
            "finetune_ckpt": {
                "denoiser": "microsoft/trellis-normal-v0-1/ckpts/ss_flow_normal_dit_L_16l8_fp16.pt"
            }
        }
    }
}
