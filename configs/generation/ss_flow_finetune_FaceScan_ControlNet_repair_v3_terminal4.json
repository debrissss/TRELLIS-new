            },
            "i_print": 10,
            "i_log": 10,
            "i_sample": 20000,
            "i_save": 1500,
            "p_uncond": 0.1,
            "t_schedule": {
                "name": "logitNormal",
                "args": {
                    "mean": 1.0,
                    "std": 1.0
                }
            },
            "sigma_min": 0.00001,
            "image_cond_model": "dinov2_vitl14_reg",
            "frozen_ss_decoder_ckpt": "outputs/train/ss_enc_dec_fine_tune_kl1e-4_lr1e-6_batch8/ckpts/decoder_step0002000.pt",
            "repair_weight": 0.1,
            "repair_warmup_steps": 500,
            "fill_weight": 2.0,
            "remove_weight": 1.0,
            "keep_weight": 0.5,
            "background_weight": 0.25,
            "background_kernel_size": 3,
            "positive_margin": 1.5,
            "negative_margin": 1.0,
            "tversky_weight": 1.0,
            "tversky_alpha": 0.3,
            "tversky_beta": 0.7,
            "repair_roi_kernel_size": 5,
            "coverage_weight": 0.5,
            "coverage_kernel_size": 3,
            "multiscale_weight": 0.5,
            "multiscale_factors": [2, 4],
            "closing_weight": 0.05,
            "closing_kernel_size": 3,
            "terminal_sampler_steps": 25,
            "terminal_unroll_steps": 4,
            "terminal_rescale_t": 3.0,
            "terminal_control_scale": 0.75,
            "terminal_loss_interval": 4,
            "finetune_ckpt": {
                "denoiser": "/root/autodl-tmp/TRELLIS-new/outputs/train/ss_flow_finetune/ckpts/denoiser_step0010000.pt"
